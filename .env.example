# Backend-owned SAP Build trigger configuration.
# Copy this file to .env and fill values from SAP Build Control Tower > Environments > Triggers > View.
SAP_BASE_URL=https://your-sap-api-gateway.example.com
# Paste the path portion of the API trigger URL from Trigger > View.
# Do not leave the placeholder incomingRequest unless that exact path appears in SAP.
SAP_API_PATH=/public/unified/v1/triggers/api/your-trigger-uid
SAP_PAYLOAD_MODE=sap_build_trigger
SAP_BUILD_CONTEXT_MODE=startEvent
SAP_BUILD_CONTEXT_FIELDS=tool_name,quantity,required_date,requester_employee_id,requester_name,requester_email,approver_name,approver_email,cost_center,estimated_net_price
SAP_BUILD_DEFINITION_ID=your-api-trigger-definition-id

# SAP Build API trigger auth. Keep these server-side; do not expose them in the browser.
SAP_AUTH_TYPE=api_key_bearer
SAP_BEARER_TOKEN=your-oauth-access-token
SAP_API_KEY=your-trigger-api-key
SAP_API_KEY_HEADER=api-key

# Optional.
SAP_CLIENT=
SAP_FETCH_CSRF=false
